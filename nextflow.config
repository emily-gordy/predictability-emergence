params {
    input = 'data/inputs.csv'
    outputavgtime = 5
}

outputDir = 'outputs/'

conda.enabled = true

profiles {
    test {
        params.input = 'data/test_inputs.csv'
    }
    local {
        process.executor = 'local'
    }
    mahuika {
        process.executor = 'slurm'
        params.publish_mode = 'copy'
    }
}